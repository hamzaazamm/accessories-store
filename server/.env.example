# MongoDB Atlas Cloud Database Connection String
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://dbUser:dbPassword@gadget-district-cluster.mongodb.net/gadget_district?retryWrites=true&w=majority

# Server Configuration
PORT=5001
NODE_ENV=development

# JWT Secret Key for Authentication
JWT_SECRET=gadget_district_ultra_secure_jwt_secret_key_2026_minimal
JWT_EXPIRE=30d

# Frontend URL for CORS
CLIENT_URL=http://localhost:3000
